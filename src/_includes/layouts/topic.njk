{% extends "layouts/base.njk" %}

{% block structuredData %}
{% topicSchema canonicalUrl, title, metaDescription, schemaType, medicalCondition, faq %}
{% endblock %}

{% block content %}
    <section>
      <div class="article-eyebrow">{{ eyebrow }}</div>
      <h1 class="article-title" style="max-width:{{ titleMaxWidth or '20ch' }};">{{ title }}</h1>

      {% for section in sections %}
      {% if section.heading %}<h2 class="page-subhead">{{ section.heading }}</h2>{% endif %}
      {% if section.type == "text" %}
      <div class="article-body">
        {{ section.body | markdownify | safe }}
      </div>
      {% elif section.type == "list" %}
      <ul class="page-list">
        {% for item in section.items %}<li>{{ item | markdownInline | safe }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% endfor %}

      <div class="mini-faq">
        {% for item in faq %}<details class="faq-item">
          <summary>
            <span>{{ item.question }}</span>
            <span class="plus">+</span>
          </summary>
          <p>{{ item.answer }}</p>
        </details>
        {% endfor %}
      </div>

      <div class="article-cta">
        <p>{{ ctaText }}</p>
        <a href="../index.html#contact" class="btn btn-lg">Book a free 20-minute consult</a>
      </div>

      <div class="related-box">
        <h3>Related</h3>
        <div class="related-links">
          {% for link in related %}<a href="{{ link.url }}">{{ link.text }}</a>
          {% endfor %}
        </div>
      </div>
    </section>

{% include "partials/footer.njk" %}
{% endblock %}
